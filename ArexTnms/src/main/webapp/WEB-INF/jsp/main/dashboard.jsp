function escapeHtml(value){return String(value==null?'':value).replace(/[&<>'"]/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[ch]))}
function hasPermission(screen,property){const p=PERMISSIONS[screen];return !!p&&p[property||'listAuthrtYn']==='Y'}
function permissionButton(screen,property,label,classes,handler){return hasPermission(screen,property)?`<button class="btn ${classes||''}" onclick="${handler}">${label}</button>`:''}
async function api(path,options={}){
  const headers=Object.assign({'X-Requested-With':'XMLHttpRequest'},options.headers||{});
  if(options.method&&options.method.toUpperCase()!=='GET')headers['X-CSRF-TOKEN']=CSRF_TOKEN;
  const response=await fetch(CONTEXT_PATH+path,Object.assign({},options,{headers}));
  let json;try{json=await response.json()}catch(e){json={success:false,message:'서버 응답을 해석하지 못했습니다.'}}
  if(response.status===401){location.replace(CONTEXT_PATH+'/login/login.do');throw new Error('로그인이 필요합니다.')}
  if(!response.ok||json.success===false)throw new Error(json.message||'요청 처리에 실패했습니다.');
  return json.data;
}
function showToast(message,bad){const old=document.querySelector('.toast');if(old)old.remove();const el=document.createElement('div');el.className='toast'+(bad?' bad':'');el.textContent=message;document.body.appendChild(el);setTimeout(()=>el.remove(),2800)}
function showModal(html){const el=document.createElement('div');el.className='modal-backdrop';el.id='modalBackdrop';el.innerHTML=`<div class="modal-panel">${html}</div>`;el.addEventListener('click',e=>{if(e.target===el)closeModal()});document.body.appendChild(el)}
function closeModal(){const el=document.getElementById('modalBackdrop');if(el)el.remove()}
function formatDate(value){return value?String(value).replace('T',' ').substring(0,19):'-'}

