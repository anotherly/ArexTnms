  <!-- 게이트웨이 설비종류: com_device_info 자체의 device_type만 조회. 별도 참조 테이블 없음. -->
  <select id="selectEquipmentClassifications" parameterType="string" resultType="map">
    SELECT DISTINCT E.device_type AS eqpmntClsfCd,
           E.device_type AS eqpmntClsfNm,
           E.device_type AS eqpmNm
      FROM com_device_info E
     WHERE E.use_yn='Y' AND E.device_type IS NOT NULL AND E.device_type != ''
       AND E.ems_id=(CASE #{_parameter} WHEN 'EMS_TX' THEN 1 WHEN 'VMS' THEN 4
          WHEN 'PBX' THEN 11 WHEN 'EMS_PIDS' THEN 13 WHEN 'SCADA_SEC' THEN 16 ELSE -1 END)
     ORDER BY E.device_type
  </select>
  <!-- com_device_info is the single equipment source. Never write ping_alive/ping_dt (gateway-owned). -->
  <insert id="insertGatewayDevice" parameterType="equipmentVO">
    INSERT INTO com_device_info
       (ems_id,device_id,device_nm,device_type,device_ip,device_station,stn_cd,
        device_maker,device_model,server_ip,device_desc,device_check,test_yn,use_yn,reg_id)
    VALUES (#{emsId},#{eqpmntMngNo},#{eqpmntNm},#{eqpmntSeCd},#{eqpmntIpAddr},#{instlPlcNm},
       #{stnCd},#{deviceMaker},#{eqpmntMdlNm},#{serverIp},#{eqpmntExpln},#{deviceCheck},#{testYn},#{useYn},#{regId})
  </insert>
  <update id="updateGatewayDevice" parameterType="equipmentVO">
    UPDATE com_device_info SET device_nm=#{eqpmntNm},device_type=#{eqpmntSeCd},device_ip=#{eqpmntIpAddr},
      device_station=#{instlPlcNm},stn_cd=#{stnCd},device_maker=#{deviceMaker},device_model=#{eqpmntMdlNm},
      server_ip=#{serverIp},device_desc=#{eqpmntExpln},device_check=#{deviceCheck},test_yn=#{testYn},use_yn=#{useYn},
      mod_dt=NOW(),mod_id=#{modId}
    WHERE ems_id=#{emsId} AND device_id=#{gatewayDeviceId}
  </update>
  <delete id="deleteGatewayDevice" parameterType="map">
    DELETE FROM com_device_info WHERE ems_id=#{emsId} AND device_id=#{deviceId}
  </delete>
  <select id="countGatewayDevice" parameterType="map" resultType="int">
    SELECT COUNT(*) FROM com_device_info WHERE ems_id=#{emsId} AND device_id=#{deviceId}
  </select>
</mapper>
